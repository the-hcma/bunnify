  "gpr": {
    "description": "Graphite PR review (Usage: gpr <org/repo> <pr_number>)",
    "url": "https://app.graphite.com/github/pr/#{repo}/#{pr_number}",
    "complete": {
      "pr_number": { "kind": "github_pull_request", "repo_param": "repo" },
      "repo": { "kind": "github_repo" }
    }
  },
