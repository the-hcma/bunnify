#!/usr/bin/env bash
set -euo pipefail

# Local preflight checks for formatting, linting and tests.
# Usage: scripts/checks [--skip-integration]

readonly uv_cmd="uv"

usage() {
    echo "Usage: $0 [--skip-integration]"
    exit 2
}

skip_integration=false
if [ "${1-}" = "--skip-integration" ]; then
    skip_integration=true
elif [ "${1-}" != "" ]; then
    usage
fi

run() {
    local cmd
    cmd="$1"
    echo "+ $cmd"
    eval "$cmd"
}

echo "🔎 Running preflight checks"

# Python formatting and linting
run "$uv_cmd run ruff check ."
run "$uv_cmd run ruff format --check ."
run "$uv_cmd run pyright --warnings"

# Shell linting (required — same gate as CI lint-shell)
if ! command -v shellcheck >/dev/null 2>&1; then
    echo "❌ shellcheck is required but not installed." >&2
    echo "   Install it, then re-run: brew install shellcheck   # macOS" >&2
    echo "                           apt-get install shellcheck # Debian/Ubuntu" >&2
    exit 1
fi
run "bash .github/ci/shellcheck"

# Django checks and unit tests
run "$uv_cmd run python manage.py check"
run "./test_bunnify"
echo "⏳ Running installed-wheel packaging smoke (timeout 180s)"
run "chmod +x ./test_packaging && timeout 180 ./test_packaging"

if [ "$skip_integration" != "true" ]; then
    echo "⏳ Running integration script (timeout 120s)"
    run "chmod +x ./test_integration && timeout 120 ./test_integration"
else
    echo "ℹ️  Skipping integration tests (use --skip-integration to skip)"
fi

echo "✅ Preflight checks completed"
